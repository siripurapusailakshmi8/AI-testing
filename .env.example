# Application Configuration
BASE_URL=https://www.saucedemo.com/
LOGIN_URL=https://example.com/login

# Browser Configuration
BROWSER=chrome
HEADLESS=false
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# Timeouts
WAIT_TIME=10
PAGE_LOAD_TIMEOUT=15
IMPLICIT_WAIT=5

# Test Credentials
TEST_USERNAME=standard_user
